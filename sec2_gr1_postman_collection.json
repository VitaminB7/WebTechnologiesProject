{
  "info": {
    "name": "CONDONG condo | ITDS242 Phase 2",
    "description": "Run in order on the seeded demo database. Keep the cookie jar enabled. Select a room photo for the multipart upload.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "loginUser",
      "value": "admin_main"
    },
    {
      "key": "loginPassword",
      "value": "Admin@1234"
    },
    {
      "key": "roomId",
      "value": "L-1999"
    },
    {
      "key": "demoAdmin",
      "value": "phase2_demo"
    },
    {
      "key": "imageId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 — Login and session",
      "item": [
        {
          "name": "Reject incorrect password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{loginUser}}\",\n  \"password\": \"wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as SuperAdmin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{loginUser}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Read current session",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 — Search and room CRUD",
      "item": [
        {
          "name": "List rooms without filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/rooms"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Search with three criteria",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/rooms?type=Deluxe%20room&floor=12&minCondition=3"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Read seeded room",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/rooms/L-1201"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create room",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/rooms",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": \"{{roomId}}\",\n  \"building\": \"Building A\",\n  \"floor\": 19,\n  \"roomType\": \"Studio\",\n  \"bedrooms\": 0,\n  \"size\": 27,\n  \"price\": 10000,\n  \"conditionRating\": 4,\n  \"minimumLease\": 12,\n  \"available\": true,\n  \"description\": \"Room created by the Phase 2 collection.\",\n  \"owner\": {\n    \"name\": \"Demo Owner\",\n    \"phone\": \"080-000-0000\"\n  },\n  \"appliances\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update room",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/rooms/{{roomId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": \"{{roomId}}\",\n  \"building\": \"Building A\",\n  \"floor\": 19,\n  \"roomType\": \"Studio\",\n  \"bedrooms\": 0,\n  \"size\": 27,\n  \"price\": 11000,\n  \"conditionRating\": 4,\n  \"minimumLease\": 12,\n  \"available\": true,\n  \"description\": \"Room created by the Phase 2 collection.\",\n  \"owner\": {\n    \"name\": \"Demo Owner\",\n    \"phone\": \"080-000-0000\"\n  },\n  \"appliances\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload room photo",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/rooms/{{roomId}}/images",
            "description": "Choose a PNG, JPEG, or WebP file no larger than 2 MB in the images field before sending.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "images",
                  "type": "file",
                  "src": "sec2_gr1_fe_src/public/img/appliance-sofa.png"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.collectionVariables.set('imageId', pm.response.json().data.images[0].imageId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete uploaded image",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/rooms/{{roomId}}/images/{{imageId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete demo room",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/rooms/{{roomId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Check the room was deleted",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/rooms/{{roomId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        }
      ]
    },
